[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "x-frame-options",                "operation": "remove" },
        { "header": "content-security-policy",        "operation": "remove" },
        { "header": "cross-origin-opener-policy",     "operation": "remove" },
        { "header": "cross-origin-embedder-policy",   "operation": "remove" },
        { "header": "cross-origin-resource-policy",   "operation": "remove" }
      ]
    },
    "condition": {
      "requestDomains": ["google.com", "lens.google.com", "www.google.com"],
      "resourceTypes": ["sub_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        { "header": "origin",  "operation": "set", "value": "https://lens.google.com" },
        { "header": "referer", "operation": "set", "value": "https://lens.google.com/" }
      ]
    },
    "condition": {
      "urlFilter": "||lens.google.com/v3/upload",
      "resourceTypes": ["xmlhttprequest"]
    }
  }
]
