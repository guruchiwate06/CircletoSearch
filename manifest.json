{
  "manifest_version": 3,
  "name": "Desktop Circle to Search",
  "version": "1.0.0",
  "description": "Draw a freehand circle on any webpage to capture a selection area — desktop-style Circle to Search.",

  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "declarativeNetRequest",
    "offscreen"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "lens_frame_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "commands": {
    "activate-overlay": {
      "suggested_key": {
        "default": "Alt+S",
        "windows": "Alt+S",
        "mac": "Alt+S",
        "linux": "Alt+S"
      },
      "description": "Toggle the Circle to Search selection overlay"
    }
  }
}

